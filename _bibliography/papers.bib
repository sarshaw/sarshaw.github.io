}

@inproceedings{aera2025liu,
  title={Enhancing K-12 Mathematics Instruction Through Human-AI Collaboration: A Comprehensive Study on Curriculum and AI Utilization},
  author={Liu, Alex and Sun, Min and Sarkar, Shawon and Males, Lorraine Marie and Tian, Zewei},
  booktitle={American Educational Research Association (AERA) Annual Meeting},
  year={2025},
  location={Denver, CO, USA},
  publisher={American Educational Research Association (AERA)},
  selected={false},
  abbr_tags={AI in Education},
  pub_type={Extended Abstracts & Non-Archival Conference Papers},
  doi={10.3102/2192190},
  keywords={Artificial Intelligence, Curriculum Design and Evaluation, Teacher Education - In-Service/Professional Development},
  abstract={This study examines the impact of AI tools on K-12 math lesson plan quality, addressing teachers' instructional challenges. Using mixed methods, including descriptive analysis, topic modeling, and interviews, we identified high-quality lesson plan features and explored how teachers use AI to refine content. Findings show teachers generally emphasize student collaboration, inclusivity, and formative assessments, with varying focuses across educational levels. Additionally, AI significantly aids in improving cognitive engagement, promoting inclusivity, and streamlining lesson preparation. While teachers grow with AI, gaps in teacher awareness of AI capabilities persist. Therefore, enhancing AI tools with domain-specific knowledge and increasing teacher professional development for educational technology integration can lead to both more effective AI tool development and more inclusive and engaging math education.}
}

@article{esbenshade2025emerging,
  title={Emerging Patterns of GenAI Use in K-12 Science and Mathematics Education},
  author={Esbenshade, Lief and Sarkar, Shawon and Nucci, Drew and Edwards, Ann and Nielsen, Sarah and Rosenberg, Joshua M. and Liu, Alex and Tian, Zewei (Victor) and Sun, Min and Zhang, Zachary and Han, Thomas and Lapicus, Yulia and He, Kevin},
  journal={Arxiv Preprint},
  year={2025},
  pdf={https://arxiv.org/pdf/2509.10747},
  selected={false},
  abbr_tags={AI in Education},
  abstract={In this report, we share findings from a nationally representative survey of US public school math and science teachers, examining current generative AI (GenAI) use, perceptions, constraints, and institutional support. We show trends in math and science teacher adoption of GenAI, including frequency and purpose of use. We describe how teachers use GenAI with students and their beliefs about GenAI's impact on student learning. We share teachers' reporting on the school and district support they are receiving for GenAI learning and implementation, and the support they would like schools and districts to provide, and close with implications for policy, practice, and research. Given the rapid pace of GenAI development and growing pressure on schools to integrate emerging technologies, these findings offer timely insights into how frontline educators are navigating this shift in practice.}
}

