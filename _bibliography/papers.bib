@article{amirizaniani2025towards,
  title={Towards More Personalized Recommendations by Modeling Users? Temporal Behaviors with Task-Based Graph Neural Network (TGNN)},
  author={Amirizaniani, Maryam and Sarkar, Shawon and Shah, Chirag},
  journal={ACM Transactions on the Web},
  volume={19},
  number={3},
  pages={1--19},
  year={2025},
  publisher={Association for Computing Machinery New York, NY, USA},
  url={https://doi.org/10.1145/3736159},
  pdf={https://dl.acm.org/doi/epdf/10.1145/3736159},
  doi = {10.1145/3736159},
  selected={true},
  keywords={User task modeling, recommendation systems, graph neural network, temporal information},
  abbr_tags={Search / Recommendation, AI / ML},
  pub_type={Journal Articles (Peer-Reviewed)},
  abstract={A recommender system is tasked with effectively analyzing a user's preferences and interactions to provide personalized recommendations. This calls for extracting and connecting various heterogeneous data while preserving their temporal relations. Graph neural networks (GNNs) have proven to be highly suitable in recommendation systems for connecting different types of user behavioral signals. However, they inherently lack ability to capture temporal aspects of underlying data. This shortcoming prevents them from explicating and utilizing task information, which is shown to be instrumental in many information retrieval applications. To overcome this limitation, we propose a new Task-based Graph Neural Network model (TGNN) focusing on identifying users' underlying tasks within their temporal multi-behavior, specifically in each session. The model consists of three modules: (1) a sequential meta-path module that captures a temporal sequence of users' behaviors; (2) a graph neural network layer that models the relationships between different information items and users into task representations; and (3) a recommendation layer that utilizes a collaborative filtering method to generate top-N recommendations based on the model's comprehension of users' tasks. The novelty of our approach lies in understanding users' tasks through their temporal behavior, enabling more accurate personalization. The results of evaluative experiments on three publicly available datasets demonstrate the effectiveness of our task-based recommendation model compared to 10 baselines and indicate a promising research direction for task-oriented recommender systems.}
}

@article{sarkar2024providing,
  title={From Rigorous Content to Engaging Activities: How do Teachers Prefer in Math Lesson Plans between AI and Human Created?},
  author={Sarkar, Shawon and Sun, Min and Liu, Alex and He, Kevin},
  journal={SREE 2024 Conference: Navigating the Future of Education Research: Impact Evaluation in a Transforming Landscape},
  year={2024},
  publisher={Society for Research on Educational Effectiveness (SREE) 2024 Conference},
  location={Baltimore, MD, USA},
  url={https://sree.memberclicks.net/assets/conferences/2024/SREE-2024-Schedule-at-a-Glance.pdf},
  selected={false},
  abbr_tags={AI in Education, HCI},
  pub_type={Extended Abstracts & Non-Archival Conference Papers},
  abstract={Teachers increasingly rely on generative AI to support lesson planning, yet general-purpose models such as ChatGPT often fall short in mathematical rigor, pedagogical alignment, and task specificity. This study examines whether specialized AI models, fine-tuned with domain knowledge and expert-labeled data, can better support K-12 mathematics lesson design. We conducted a controlled evaluation with 20 experienced math teachers, comparing lesson plans created by human curriculum designers, a customized GPT-4 model, and a fine-tuned LLaMA-2-13B model across elementary, middle, and high school levels. Teachers assessed lesson components including warm-ups, main tasks, cool-down activities, and overall instructional quality. Results show that while human-created lessons remain preferred overall—particularly at the elementary level—AI-generated materials perform competitively in secondary education contexts. Notably, AI-generated cool-down activities were consistently favored, and the fine-tuned LLaMA model matched or outperformed human lessons in high-school main task quality. These findings suggest that domain-specific fine-tuning enables AI systems to meaningfully augment teacher workflows, offering a cost-effective pathway toward high-quality, pedagogically aligned instructional support rather than wholesale replacement of human expertise.}
}

